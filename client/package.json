{
  "name": "h23s_15",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run start-mock\"",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "fmt": "prettier --write --ignore-path ./.prettierignore src/",
    "fmt:check": "prettier --check --ignore-path ./.prettierignore src/",
    "lint": "eslint \"src/**/*.{vue,js,jsx,mjs,ts,tsx,mts}\" --fix",
    "openapi-gen": "openapi --input ../docs/openapi.yaml --output src/apis/generated --client fetch --name AppClient",
    "start-mock": "prism mock -p 4010 -d ../docs/openapi.yaml"
  },
  "dependencies": {
    "vue": "^3.5.43",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify/vue": "^5.0.3",
    "@stoplight/prism-cli": "^5.15.11",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "openapi-typescript-codegen": "^0.31.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.2.1"
}
